<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
             xmlns:headered="clr-namespace:ClassicAssist.Controls.Headered;assembly=ClassicAssist.Controls"
             x:Class="ClassicAssist.UI.Views.PvpSections.PvpGuardSection">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resources/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="{x:Static resources:Strings.Innocent_guard_zone_warning_hint}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundColor3Brush}" Margin="0,0,0,10" />
            <headered:HorizontalHeaderedTextBox Header="{x:Static resources:Strings.Innocent_guard_zone_warning_message_}" Text="{Binding CurrentOptions.TargetNextInnocentGuardWarningMessage}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static resources:Strings.Innocent_guard_zone_warning_hue_}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentOptions.TargetNextInnocentGuardWarningHue}" FontFamily="Consolas" Margin="8,0" />
                <Button Grid.Column="2" Content="Palette" Command="{Binding SelectInnocentGuardHueCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
