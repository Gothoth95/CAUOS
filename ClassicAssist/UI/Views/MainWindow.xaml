<Window x:Class="ClassicAssist.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassicAssist.UI.Views"
        xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels"
        xmlns:r="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
        xmlns:misc="clr-namespace:ClassicAssist.UI.Misc"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:browser="clr-namespace:ClassicAssist.Browser"
        xmlns:behaviours="clr-namespace:ClassicAssist.UI.Misc.Behaviours"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        x:Name="window"
        Height="760" Width="900" MinHeight="520" MinWidth="760"
        Topmost="{Binding CurrentOptions.AlwaysOnTop}"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource UiFontSizeBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowsTransparency="False" WindowStyle="None" WindowState="Normal"
        Title="{Binding Title}" ResizeMode="CanResizeWithGrip">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>
    <i:Interaction.Behaviors>
        <misc:LoadOptionsOnWindowLoaded />
        <behaviours:WindowResizeBehaviour />
    </i:Interaction.Behaviors>
    <Window.DataContext>
        <viewModels:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1" CornerRadius="0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource ShellTitleBarBrush}">
                <Grid Margin="14,0">
                    <i:Interaction.Behaviors>
                        <behaviours:WindowMouseDownBehaviour />
                    </i:Interaction.Behaviors>
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding MaximizeWindowCommand}"
                                      CommandParameter="{Binding ElementName=window}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="0"
                                Background="{DynamicResource AccentColorBrush}" Margin="0,0,8,0">
                            <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ClassicAssist" Foreground="{DynamicResource ForegroundColor1Brush}"
                                   FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Padding="0" Width="28" Height="28"
                                Background="Transparent" Foreground="{DynamicResource ForegroundColor2Brush}"
                                BorderThickness="0" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding DebugCommand}">
                            <Image Source="{StaticResource bugIcon}" Height="14" Width="14" />
                        </Button>
                        <Button Padding="0" Width="28" Height="28" MinWidth="28" MinHeight="28"
                                Background="Transparent"
                                Foreground="{DynamicResource ForegroundColor2Brush}"
                                BorderThickness="0" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <i:Interaction.Behaviors>
                                <behaviours:WindowCommandBehaviour Command="Minimize"
                                    MinimizeCommand="{Binding MinimizeCommand}" />
                            </i:Interaction.Behaviors>
                            <Image Source="{StaticResource minusIcon}" Width="10" Height="10" />
                        </Button>
                        <Button Padding="0" Width="28" Height="28" MinWidth="28" MinHeight="28"
                                Background="Transparent"
                                Foreground="{DynamicResource ForegroundColor2Brush}"
                                BorderThickness="0" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <i:Interaction.Behaviors>
                                <behaviours:WindowCommandBehaviour Command="Maximize" />
                            </i:Interaction.Behaviors>
                            <Image Source="{StaticResource squareIcon}" Width="10" Height="10" />
                        </Button>
                        <Button Padding="0" Width="28" Height="28" MinWidth="28" MinHeight="28"
                                Background="Transparent"
                                Foreground="{DynamicResource ForegroundColor2Brush}"
                                BorderThickness="0" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <i:Interaction.Behaviors>
                                <behaviours:WindowCommandBehaviour Command="Close" />
                            </i:Interaction.Behaviors>
                            <Image Source="{StaticResource closeIcon}" Width="10" Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource ShellSidebarGradientBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,10,2,10">
                            <ListBox ItemsSource="{Binding NavEntries}"
                                     SelectedIndex="{Binding CurrentOptions.SelectedTabIndex, Mode=TwoWay}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FocusVisualStyle="{x:Null}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="0"
                                                            Margin="6,1" SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,7" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#1F2133" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{StaticResource ShellNavActiveBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:MainNavEntry}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center"
                                                       Margin="0,0,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource ForegroundColor2Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                                Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource ForegroundColor2Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                                Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,12,16,8">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource ForegroundColor1Brush}"
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" />
                        <Border Height="1" Margin="0,7,0,0"
                                Background="{DynamicResource ThemeBorderBrush}"
                                SnapsToDevicePixels="True" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="12,0,12,12"
                            Background="{StaticResource ShellContentWellGradientBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="8">
                        <TabControl SelectedIndex="{Binding CurrentOptions.SelectedTabIndex, Mode=TwoWay}"
                                    Style="{StaticResource ChromeTabControlStyle}">
                            <TabItem Header="{x:Static r:Strings.General}">
                                <local:GeneralControl />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.Options}">
                                <local:OptionsTabControl DataContext="{Binding OptionsTab}" />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.Hotkeys}">
                                <local:HotkeysTabControl />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.Macros}">
                                <local:MacrosTabControl />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.Skills}">
                                <local:SkillsTabControl />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.Agents}">
                                <local:AgentsTabControl />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.Public_Macros}">
                                <browser:MacroBrowserControl />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.Timers}">
                                <local:TimerTabControl />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.PvP}">
                                <local:PvpTabControl DataContext="{Binding OptionsTab}" />
                            </TabItem>
                            <TabItem Header="{x:Static r:Strings.About}">
                                <local:AboutControl />
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
