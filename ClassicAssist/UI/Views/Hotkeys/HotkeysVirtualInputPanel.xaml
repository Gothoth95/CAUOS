<UserControl x:Class="ClassicAssist.UI.Views.Hotkeys.HotkeysVirtualInputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
             xmlns:valueConverters="clr-namespace:ClassicAssist.UI.Misc.ValueConverters"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="760">
    <UserControl.Resources>
        <valueConverters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="VirtualKeyboardHeaderTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <TabPanel IsItemsHost="True" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VirtualKeyBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#4D4D4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ModifierVisualPressed}" Value="True" />
                        <Condition Binding="{Binding HasBind}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#4A3F18" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HasBind}" Value="True">
                    <Setter Property="Background" Value="#2E5B2E" />
                    <Setter Property="BorderBrush" Value="#53A653" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ModifierVisualPressed}" Value="True">
                    <Setter Property="BorderBrush" Value="#E6C200" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#2E3F76" />
                    <Setter Property="BorderBrush" Value="#78A8FF" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VirtualKeyboardItemStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="Grid.Row" Value="{Binding Row}" />
            <Setter Property="Grid.Column" Value="{Binding Column}" />
            <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
            <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="VirtualMouseItemStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="Grid.Row" Value="{Binding Row}" />
            <Setter Property="Grid.Column" Value="{Binding Column}" />
            <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </UserControl.Resources>
    <GroupBox Header="Input virtuale (Tastiera + Mouse)" Margin="0">
        <StackPanel Margin="0,2,0,0">
            <TabControl Style="{StaticResource VirtualKeyboardHeaderTabControl}"
                        SelectedIndex="{Binding VirtualKeyboardTabIndex}">
                <TabItem Header="{x:Static resources:Strings.VK_Tab_Default}" />
                <TabItem Header="{x:Static resources:Strings.VK_Tab_Shift}" />
                <TabItem Header="{x:Static resources:Strings.VK_Tab_AltGr}" />
            </TabControl>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          MaxHeight="260" Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding VirtualKeyboardKeys}">
                    <ItemsControl.ItemContainerStyle>
                        <StaticResource ResourceKey="VirtualKeyboardItemStyle" />
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource VirtualKeyBorderStyle}" ToolTip="{Binding TooltipText}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.AssignVirtualKeyboardHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                    <TextBlock Text="{Binding MainDisplay}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="11"
                                               Foreground="{DynamicResource ThemeForegroundBrush}" />
                                    <TextBlock Text="{Binding SubLine}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="9"
                                               Opacity="0.72"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource ThemeForegroundBrush}"
                                               Visibility="{Binding ShowSubLine, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Height="1" Margin="0,10,0,8" Background="{DynamicResource ThemeBorderBrush}" />
            <TextBlock Text="Mouse Virtuale Bind"
                       Foreground="{DynamicResource ThemeForegroundBrush}"
                       Margin="2,0,0,6"
                       FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding MouseButtons}">
                <ItemsControl.ItemContainerStyle>
                    <StaticResource ResourceKey="VirtualMouseItemStyle" />
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource VirtualKeyBorderStyle}" Height="24"
                                ToolTip="{Binding TooltipText}">
                            <TextBlock Text="{Binding DisplayText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource ThemeForegroundBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </GroupBox>
</UserControl>
